<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="castle" type="Castle.Windsor.Configuration.AppDomain.CastleSectionHandler, Castle.Windsor"/>
  </configSections>

  <castle>
    <components>
      <component id="myObjectID" type="CastleWindsorPlayground.MyObject, CastleWindsorPlayground">
        <parameters>
          <_stuff>
            <dictionary keyType="System.Int32, mscorlib">
              <entry key="0">
                <array>
                  <item>string1</item>
                  <item>string2</item>
                </array>
              </entry>
            </dictionary>
          </_stuff>
        </parameters>
      </component>
    </components>
  </castle>
  
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/></startup></configuration>
